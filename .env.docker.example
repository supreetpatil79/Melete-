# Docker Compose environment overrides

# Frontend published port
FRONTEND_PORT=8090

# Optional Redis for backend distributed cache/rate-limit
# REDIS_URL=redis://host.docker.internal:6379
MAX_CONCURRENT_CODE_EXEC_REQUESTS=36
MAX_CONCURRENT_AI_REQUESTS=24
MAX_CONCURRENT_VIDEO_REQUESTS=28
MAX_CONCURRENT_TECH_NEWS_REQUESTS=18
MAX_CONCURRENT_QUESTION_REQUESTS=20
SEARCH_BACKEND=elasticsearch

# Elasticsearch container controls
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Elasticsearch backend for /api/search:
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=learner-compass-catalog
ELASTICSEARCH_UNIFIED_INDEX=learner-compass-unified-search
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_REQUEST_TIMEOUT_MS=2500
ELASTICSEARCH_SYNC_ON_BOOT=true

# Code execution provider configuration
CODE_EXEC_PROVIDER=judge0
CODE_EXEC_API_URL=
# If empty, backend automatically uses built-in local JS sandbox fallback
CODE_EXEC_ENABLE_FALLBACK=true
CODE_EXEC_FALLBACK_PROVIDER=local-js
CODE_EXEC_FALLBACK_API_URL=
CODE_EXEC_API_KEY=
CODE_EXEC_API_HOST=judge0-ce.p.rapidapi.com

# OpenAI adaptive coaching
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# YouTube personalized feed
YOUTUBE_API_KEY=
